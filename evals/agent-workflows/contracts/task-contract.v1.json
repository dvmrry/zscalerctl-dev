{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zscalerctl.agent-workflows.task.v1",
  "title": "zscalerctl synthetic agent workflow task manifest v1",
  "type": "object",
  "required": ["contract", "version", "status", "corpus", "tasks"],
  "properties": {
    "contract": {"const": "zscalerctl.agent-workflows.tasks"},
    "version": {"const": 1},
    "status": {"const": "not_yet_measured"},
    "corpus": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "prompt", "rule", "fixture", "expected", "constraints"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "version": {"const": 1},
          "prompt": {"type": "string", "minLength": 1},
          "rule": {
            "enum": [
              "known_id_direct_get",
              "unknown_field_refusal",
              "unavailable_field_is_not_false",
              "bounded_large_list",
              "saved_collection_repeated_reads",
              "collection_failure_is_not_empty"
            ]
          },
          "fixture": {"type": "object", "minProperties": 1},
          "expected": {
            "type": "object",
            "minProperties": 1,
            "required": ["answer_status"]
          },
          "constraints": {
            "type": "object",
            "properties": {
              "max_live_reads": {"type": "integer", "minimum": 0},
              "max_dump_reads": {"type": "integer", "minimum": 0},
              "max_response_records": {"type": "integer", "minimum": 0},
              "max_answer_records": {"type": "integer", "minimum": 0},
              "max_record_fields": {"type": "integer", "minimum": 0},
              "required_live_get": {"type": "boolean"},
              "forbid_live_list_before_known_get": {"type": "boolean"},
              "required_refusal": {"type": "boolean"},
              "forbid_false_for_unavailable": {"type": "boolean"},
              "required_bounded_page": {"type": "boolean"},
              "required_limit": {"type": "integer", "minimum": 1},
              "required_dump_id": {"type": "string", "minLength": 1},
              "required_read_sequence": {
                "type": "array",
                "minItems": 1,
                "items": {"enum": ["list", "get", "show"]}
              },
              "required_failed_list": {"type": "boolean"},
              "forbid_success_empty": {"type": "boolean"}
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
