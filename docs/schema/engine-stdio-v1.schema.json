          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ZSCALERCTL_CLIENT_ID",
              "ZSCALERCTL_CLIENT_SECRET",
              "ZSCALERCTL_VANITY_DOMAIN",
              "ZSCALERCTL_ZPA_CUSTOMER_ID",
              "ZSCALERCTL_ZIA_USERNAME",
              "ZSCALERCTL_ZIA_PASSWORD",
              "ZSCALERCTL_ZIA_API_KEY",
              "ZSCALERCTL_ZIA_CLOUD"
            ]
          }
        }
      }
    },
    "nonCredentialFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "usage",
            "unsupported_capability",
            "unsupported_operation",
            "unknown_resource",
            "not_found",
            "invalid_resource_id",
            "live_access_failed",
            "deadline_exceeded",
            "invalid_config",
            "invalid_proxy_config",
            "unsupported_resource",
            "response_too_large",
            "internal"
          ]
        }
      }
    },
    "canceled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "error"],
      "properties": {
        "type": { "const": "canceled" },
        "id": { "$ref": "#/$defs/requestID" },
        "seq": { "$ref": "#/$defs/sequence" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "canceled" } }
        }
      }
    },
    "protocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fatal", "error"],
      "properties": {
        "type": { "const": "protocol_error" },
        "fatal": { "const": true },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["protocol_violation", "unsupported_protocol", "frame_too_large", "internal"]
            }
          }
        }
      }
    }
  }
}
