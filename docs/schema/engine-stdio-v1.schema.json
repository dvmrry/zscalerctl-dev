{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zscalerctl:engine-stdio:protocol:1",
  "title": "zscalerctl local stdio engine protocol v1 frames",
  "description": "Strict client and server frame union after successful bootstrap negotiation of local stdio engine protocol version 1.",
  "oneOf": [
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/manifestRequest" },
    { "$ref": "#/$defs/catalogRequest" },
    { "$ref": "#/$defs/doctorRequest" },
    { "$ref": "#/$defs/authStatusRequest" },
    { "$ref": "#/$defs/configStatusRequest" },
    { "$ref": "#/$defs/urlLookupRequest" },
    { "$ref": "#/$defs/resourceListRequest" },
    { "$ref": "#/$defs/resourceGetRequest" },
    { "$ref": "#/$defs/resourceShowRequest" },
    { "$ref": "#/$defs/dumpRequest" },
    { "$ref": "#/$defs/diffRequest" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/requestRejected" },
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/catalogItem" },
    { "$ref": "#/$defs/urlClassificationItem" },
    { "$ref": "#/$defs/projectedRecordItem" },
    { "$ref": "#/$defs/diffResourceItem" },
    { "$ref": "#/$defs/diffAddedItem" },
    { "$ref": "#/$defs/diffRemovedItem" },
    { "$ref": "#/$defs/diffFieldChangeItem" },
    { "$ref": "#/$defs/itemBegin" },
    { "$ref": "#/$defs/itemChunk" },
    { "$ref": "#/$defs/itemEnd" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/warning" },
    { "$ref": "#/$defs/completed" },
    { "$ref": "#/$defs/failed" },
    { "$ref": "#/$defs/canceled" },
    { "$ref": "#/$defs/protocolError" }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requestID": { "$ref": "#/$defs/positiveSafeInteger" },
    "sequence": { "$ref": "#/$defs/positiveSafeInteger" },
    "product": {
      "type": "string",
      "enum": ["zia", "zpa", "ztw", "zcc", "zidentity"]
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "fieldName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "controlString": {
      "type": "string",
      "maxLength": 8192
    },
    "pathInput": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "redaction": {
      "type": "string",
      "enum": ["standard", "share", "paranoid"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_frame_bytes",
        "server_frame_bytes",
        "json_depth",
        "aggregate_item_bytes",
        "fragment_chunk_bytes",
        "url_count",
        "read_field_count",
        "read_filter_count",
        "product_selector_count",
        "resource_selector_count",
        "path_bytes",
        "control_string_bytes"
      ],
      "properties": {
        "client_frame_bytes": { "const": 1048576 },
        "server_frame_bytes": { "const": 1048576 },
        "json_depth": { "const": 64 },
        "aggregate_item_bytes": { "const": 67108864 },
        "fragment_chunk_bytes": { "const": 524288 },
        "url_count": { "const": 1024 },
        "read_field_count": { "const": 1024 },
        "read_filter_count": { "const": 1024 },
        "product_selector_count": { "const": 16 },
        "resource_selector_count": { "const": 4096 },
        "path_bytes": { "const": 32768 },
        "control_string_bytes": { "const": 8192 }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "version", "schema", "server", "limits", "engine"],
      "properties": {
        "type": { "const": "ready" },
        "protocol": { "const": "zscalerctl.engine.stdio" },
        "version": { "const": "1" },
        "schema": { "$ref": "#/$defs/schemaIdentity" },
        "server": { "$ref": "#/$defs/serverBuild" },
        "limits": { "$ref": "#/$defs/limits" },
        "engine": { "$ref": "#/$defs/engineManifest" }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "urn:zscalerctl:engine-stdio:protocol:1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "serverBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "zscalerctl-engine" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "engineManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tenant_read_only", "capabilities"],
      "properties": {
        "version": { "const": "engine.v1" },
        "tenant_read_only": { "const": true },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/engineCapability" }
        }
      }
    },
    "engineCapability": {
      "oneOf": [
        { "$ref": "#/$defs/manifestCapability" },
        { "$ref": "#/$defs/catalogCapability" },
        { "$ref": "#/$defs/statusCapability" },
        { "$ref": "#/$defs/urlLookupCapability" },
        { "$ref": "#/$defs/resourceReadCapability" },
        { "$ref": "#/$defs/dumpCapability" },
        { "$ref": "#/$defs/diffCapability" }
      ]
    },
    "manifestCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "engine.manifest" },
        "operations": { "const": ["manifest"] },
        "input": { "const": "none" },
        "result": { "const": "engine_manifest" },
        "tenant_read_only": { "const": true },
        "effects": { "const": [] }
      }
    },
    "catalogCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "catalog.schema" },
        "operations": { "const": ["list"] },
        "input": { "const": "none" },
        "result": { "const": "resource_catalog" },
        "tenant_read_only": { "const": true },
        "effects": { "const": [] }
      }
    },
    "statusCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "status.inspect" },
        "operations": { "const": ["doctor", "auth_status", "config_status"] },
        "input": { "const": "status" },
        "result": { "const": "status" },
        "tenant_read_only": { "const": true },
        "effects": {
          "const": [
            { "kind": "local_filesystem_read", "when": "configuration_dependent" }
          ]
        }
      }
    },
    "urlLookupCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "zia.url_lookup" },
        "operations": { "const": ["lookup"] },
        "input": { "const": "url_lookup" },
        "result": { "const": "url_classifications" },
        "tenant_read_only": { "const": true },
        "effects": {
          "const": [
            { "kind": "local_filesystem_read", "when": "configuration_dependent" },
            { "kind": "network_access", "when": "always" },
            { "kind": "process_execution", "when": "configuration_dependent" }
          ]
        }
      }
    },
    "resourceReadCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "resources.read" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["list", "get", "show"] }
        },
        "input": { "const": "resource_read" },
        "result": { "const": "projected_records" },
        "tenant_read_only": { "const": true },
        "effects": {
          "const": [
            { "kind": "local_filesystem_read", "when": "configuration_dependent" },
            { "kind": "network_access", "when": "always" },
            { "kind": "process_execution", "when": "configuration_dependent" }
          ]
        }
      }
    },
    "dumpCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "dump.write" },
        "operations": { "const": ["dump"] },
        "input": { "const": "dump" },
        "result": { "const": "dump_summary" },
        "tenant_read_only": { "const": true },
        "effects": {
          "const": [
            { "kind": "local_filesystem_read", "when": "always" },
            { "kind": "local_filesystem_write", "when": "always" },
            { "kind": "local_filesystem_delete", "when": "request_dependent" },
            { "kind": "network_access", "when": "always" },
            { "kind": "process_execution", "when": "configuration_dependent" }
          ]
        }
      }
    },
    "diffCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operations", "input", "result", "tenant_read_only", "effects"],
      "properties": {
        "name": { "const": "diff.compare" },
        "operations": { "const": ["diff"] },
        "input": { "const": "diff" },
        "result": { "const": "diff_report" },
        "tenant_read_only": { "const": true },
        "effects": {
          "const": [
            { "kind": "local_filesystem_read", "when": "always" }
          ]
        }
      }
    },
    "operation": {
      "type": "string",
      "enum": [
        "manifest",
        "list",
        "get",
        "show",
        "doctor",
        "auth_status",
        "config_status",
        "lookup",
        "dump",
        "diff"
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "when"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local_filesystem_read",
            "local_filesystem_write",
            "local_filesystem_delete",
            "network_access",
            "process_execution"
          ]
        },
        "when": {
          "type": "string",
          "enum": ["always", "request_dependent", "configuration_dependent"]
        }
      }
    },
    "manifestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "engine.manifest" },
        "operation": { "const": "manifest" }
      }
    },
    "catalogRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "catalog.schema" },
        "operation": { "const": "list" }
      }
    },
    "doctorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "status.inspect" },
        "operation": { "const": "doctor" }
      }
    },
    "authStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "status.inspect" },
        "operation": { "const": "auth_status" }
      }
    },
    "configStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "status.inspect" },
        "operation": { "const": "config_status" }
      }
    },
    "urlLookupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation", "input"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "zia.url_lookup" },
        "operation": { "const": "lookup" },
        "input": { "$ref": "#/$defs/urlLookupInput" }
      }
    },
    "urlLookupInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
        }
      }
    },
    "resourceListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation", "input"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "resources.read" },
        "operation": { "const": "list" },
        "input": { "$ref": "#/$defs/resourceListInput" }
      }
    },
    "resourceListInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "resource", "fields", "filters", "search"],
      "properties": {
        "product": { "$ref": "#/$defs/product" },
        "resource": { "$ref": "#/$defs/resourceName" },
        "fields": { "$ref": "#/$defs/fieldSelection" },
        "filters": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/filter" }
        },
        "search": { "$ref": "#/$defs/controlString" }
      }
    },
    "resourceGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation", "input"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "resources.read" },
        "operation": { "const": "get" },
        "input": { "$ref": "#/$defs/resourceGetInput" }
      }
    },
    "resourceGetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "resource", "record_id", "fields"],
      "properties": {
        "product": { "$ref": "#/$defs/product" },
        "resource": { "$ref": "#/$defs/resourceName" },
        "record_id": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "fields": { "$ref": "#/$defs/fieldSelection" }
      }
    },
    "resourceShowRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation", "input"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "resources.read" },
        "operation": { "const": "show" },
        "input": { "$ref": "#/$defs/resourceShowInput" }
      }
    },
    "resourceShowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "resource", "fields"],
      "properties": {
        "product": { "$ref": "#/$defs/product" },
        "resource": { "$ref": "#/$defs/resourceName" },
        "fields": { "$ref": "#/$defs/fieldSelection" }
      }
    },
    "fieldSelection": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fieldName" }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "$ref": "#/$defs/fieldName" },
        "operator": { "type": "string", "enum": ["exact", "contains"] },
        "value": { "$ref": "#/$defs/controlString" }
      }
    },
    "dumpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation", "input"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "dump.write" },
        "operation": { "const": "dump" },
        "input": { "$ref": "#/$defs/dumpInput" }
      }
    },
    "dumpInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_dir", "products", "resources", "continue_on_error", "force"],
      "properties": {
        "output_dir": { "$ref": "#/$defs/pathInput" },
        "products": { "$ref": "#/$defs/productSelection" },
        "resources": { "$ref": "#/$defs/resourceSelection" },
        "continue_on_error": { "type": "boolean" },
        "force": { "type": "boolean" }
      }
    },
    "diffRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "capability", "operation", "input"],
      "properties": {
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/requestID" },
        "capability": { "const": "diff.compare" },
        "operation": { "const": "diff" },
        "input": { "$ref": "#/$defs/diffInput" }
      }
    },
    "diffInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_dir", "new_dir", "products", "resources", "ignore_operational", "allow_partial"],
      "properties": {
        "old_dir": { "$ref": "#/$defs/pathInput" },
        "new_dir": { "$ref": "#/$defs/pathInput" },
        "products": { "$ref": "#/$defs/productSelection" },
        "resources": { "$ref": "#/$defs/resourceSelection" },
        "ignore_operational": { "type": "boolean" },
        "allow_partial": { "type": "boolean" }
      }
    },
    "productSelection": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/product" }
    },
    "resourceSelection": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resourceSelector" }
    },
    "resourceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "resource"],
      "properties": {
        "product": { "$ref": "#/$defs/product" },
        "resource": { "$ref": "#/$defs/resourceName" }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "cancel" },
        "id": { "$ref": "#/$defs/requestID" }
      }
    },
    "requestRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reason"],
      "properties": {
        "type": { "const": "request_rejected" },
        "id": { "$ref": "#/$defs/requestID" },
        "reason": { "const": "busy" }
      }
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "capability", "operation"],
      "properties": {
        "type": { "const": "started" },
        "id": { "$ref": "#/$defs/requestID" },
        "seq": { "$ref": "#/$defs/sequence" },
        "capability": {
          "type": "string",
          "enum": [
            "engine.manifest",
            "catalog.schema",
            "status.inspect",
            "zia.url_lookup",
            "resources.read",
            "dump.write",
            "diff.compare"
          ]
        },
        "operation": { "$ref": "#/$defs/operation" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "capability": { "const": "engine.manifest" },
                "operation": { "const": "manifest" }
              }
            },
            {
              "properties": {
                "capability": { "const": "catalog.schema" },
                "operation": { "const": "list" }
              }
            },
            {
              "properties": {
                "capability": { "const": "status.inspect" },
                "operation": { "const": "doctor" }
              }
            },
            {
              "properties": {
                "capability": { "const": "status.inspect" },
                "operation": { "const": "auth_status" }
              }
            },
            {
              "properties": {
                "capability": { "const": "status.inspect" },
                "operation": { "const": "config_status" }
              }
            },
            {
              "properties": {
                "capability": { "const": "zia.url_lookup" },
                "operation": { "const": "lookup" }
              }
            },
            {
              "properties": {
                "capability": { "const": "resources.read" },
                "operation": { "const": "list" }
              }
            },
            {
              "properties": {
                "capability": { "const": "resources.read" },
                "operation": { "const": "get" }
              }
            },
            {
              "properties": {
                "capability": { "const": "resources.read" },
                "operation": { "const": "show" }
              }
            },
            {
              "properties": {
                "capability": { "const": "dump.write" },
                "operation": { "const": "dump" }
              }
            },
            {
              "properties": {
                "capability": { "const": "diff.compare" },
                "operation": { "const": "diff" }
              }
            }
          ]
        }
      ]
    },
    "itemKind": {
      "type": "string",
      "enum": [
        "catalog_resource",
        "url_classification",
        "projected_record",
        "diff_resource",
        "diff_added",
        "diff_removed",
        "diff_field_change"
      ]
    },
    "catalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "kind", "item"],
      "properties": {
        "type": { "const": "item" },
        "id": { "$ref": "#/$defs/requestID" },
        "seq": { "$ref": "#/$defs/sequence" },
        "kind": { "const": "catalog_resource" },
        "item": { "$ref": "#/$defs/catalogResource" }
      }
    },
    "urlClassificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "kind", "item"],
      "properties": {
        "type": { "const": "item" },
        "id": { "$ref": "#/$defs/requestID" },
        "seq": { "$ref": "#/$defs/sequence" },
        "kind": { "const": "url_classification" },
        "item": { "$ref": "#/$defs/urlClassification" }
      }
    },
    "projectedRecordItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "seq", "kind", "item"],
      "properties": {
        "type": { "const": "item" },
        "id": { "$ref": "#/$defs/requestID" },
        "seq": { "$ref": "#/$defs/sequence" },
        "kind": { "const": "projected_record" },
        "item": { "$ref": "#/$defs/projectedRecord" }
      }
