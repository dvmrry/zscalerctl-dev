{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dvmrry/zscalerctl/main/docs/schema/list-page.schema.json",
  "title": "zscalerctl bounded JSON resource list page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records",
    "pagination"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pagination": {
      "$ref": "#/$defs/pagination"
    }
  },
  "$defs": {
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "limit",
        "returned_count",
        "matched_count",
        "has_more",
        "next_offset",
        "collection_complete"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "collection_complete": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_offset": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "has_more": {
                "const": false
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_offset": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
